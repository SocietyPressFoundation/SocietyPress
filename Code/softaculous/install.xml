<softinstall xmlns="http://www.softaculous.com">

	<!--
		SocietyPress — Softaculous Install Form

		WHY this file looks the way it does: the grammar is Softaculous's, not
		ours. <softinstall> is the root element (there is no outer <install>
		wrapper), groups are wrapped in <settings>, a group's heading is a child
		element rather than an attribute, and an input's name and default value
		are attributes rather than child elements. Language strings are
		interpolated with {{key}}, not [[key]]. An earlier revision of this file
		got every one of those wrong, which would have produced an empty
		installation form. The reference is /var/softaculous/wp/install.xml.

		Field ordering follows the volunteer's mental model rather than the
		software's: what the site is called, who runs it, then the technical
		knobs they should not have to touch.
	-->

	<settings>

		<group>
			<heading>{{site_set}}</heading>
			<input type="text" name="site_name" size="30" value="My Genealogical Society">
				<head>{{site_name}}</head>
				<exp>{{exp_site_name}}</exp>
			</input>
			<input type="text" name="site_desc" size="30" value="">
				<head>{{site_desc}}</head>
				<exp>{{exp_site_desc}}</exp>
				<optional>true</optional>
			</input>
		</group>

		<group>
			<heading>{{org_set}}</heading>
			<input type="text" name="org_name" size="30" value="">
				<head>{{org_name}}</head>
				<exp>{{exp_org_name}}</exp>
				<optional>true</optional>
			</input>
			<input type="text" name="org_email" size="30" value="" softmail="true">
				<head>{{org_email}}</head>
				<exp>{{exp_org_email}}</exp>
				<optional>true</optional>
			</input>
		</group>

		<group>
			<heading>{{ad_act}}</heading>
			<input type="text" name="admin_username" size="30" value="admin" save="true">
				<head>{{ad_name}}</head>
			</input>
			<input type="text" name="admin_pass" size="30" value="">
				<head>{{ad_pass}}</head>
			</input>
			<input type="text" name="admin_email" size="30" value="" softmail="true" save="true">
				<head>{{ad_email}}</head>
				<exp>{{exp_ad_email}}</exp>
			</input>
		</group>

		<group>
			<heading>{{db_set}}</heading>
			<input type="text" name="dbprefix" size="30" value="wp_">
				<head>{{db_pre}}</head>
				<exp>{{exp_db_pre}}</exp>
				<optional>true</optional>
			</input>
		</group>

		<group>
			<heading>{{ext_settings}}</heading>
			<!--
				Exposed as an unchecked box rather than hardcoded. A previous
				revision forced blog_public to 0 during install, so every society
				launched invisible to search engines with no indication why — and
				the setting that fixes it lives three menus deep in WordPress,
				where a volunteer will never find it. Societies exist to be found.
			-->
			<input type="checkbox" name="no_search_engine" value="off">
				<head>{{no_search_engine}}</head>
				<exp>{{exp_no_search_engine}}</exp>
			</input>
		</group>

	</settings>

	<!-- Softaculous creates and provisions the database when this is present. -->
	<db>mysql</db>

</softinstall>
